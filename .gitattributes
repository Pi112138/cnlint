# 默认：自动识别文本文件，仓库内统一存为 LF
* text=auto eol=lf

# 文档与配置：强制 LF，避免跨平台差异
*.md      text eol=lf
*.markdown text eol=lf
*.txt     text eol=lf
*.json    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.js      text eol=lf
*.mjs     text eol=lf
*.cjs     text eol=lf
*.ts      text eol=lf

# Windows 批处理与 PowerShell 脚本：保持 CRLF
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# 二进制文件：不做换行转换、不做文本 diff
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.webp    binary
*.pdf     binary
*.zip     binary
*.gz      binary
*.woff    binary
*.woff2   binary

# 语言统计：把文档归入文档类，避免污染代码占比
*.md      linguist-documentation
LICENSE   linguist-documentation